# =========================================================================
# CONFIGURACIÓN DOCKER - TELCOM 2.0
# =========================================================================

# Puerto y credenciales de la base de datos PostgreSQL
DB_PORT=5432
DB_DATABASE=telcom_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Clave de cifrado de la aplicación Laravel (32 bytes base64)
APP_KEY=base64:xY2F2lF4smNPRzcrUPktNIoAHrOuFOrP/dxj07jO+uE=

# Entorno de la aplicación (local o production)
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Puertos expuestos y URL de la API para el frontend (/api usa el proxy de Nginx)
BIND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=80
VITE_API_URL=/api
CORS_ALLOWED_ORIGINS=https://tudominio.com

# Inicialización automática de base de datos al arrancar el contenedor
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# API de Inteligencia Artificial (Gemini - CU30 / CU31)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=20
